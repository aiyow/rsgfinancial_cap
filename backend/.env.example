# Server configuration
PORT=5000

# PostgreSQL local database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rsg_condo
DB_USER=postgres
DB_PASSWORD=replace_with_your_postgres_password

# Authentication
JWT_SECRET=replace_with_a_long_random_secret

# Initial Admin and Collector accounts used by `npm run seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace_with_a_strong_password
SEED_COLLECTOR_EMAIL=collector@example.com
SEED_COLLECTOR_PASSWORD=replace_with_a_strong_password

# Frontend URL
CLIENT_URL=http://localhost:5173

# Gmail SMTP email notifications. In Google Account Security, enable 2-Step
# Verification, then create a 16-character App Password for this application.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=yourgmail@gmail.com
SMTP_PASSWORD=your_16_character_google_app_password
SMTP_FROM="RSG Condo Billing <yourgmail@gmail.com>"

# Private Cloudinary payment-receipt storage. Keep these backend-only.
CLOUDINARY_CLOUD_NAME=replace_with_your_cloud_name
CLOUDINARY_API_KEY=replace_with_your_api_key
CLOUDINARY_API_SECRET=replace_with_your_api_secret
CLOUDINARY_RECEIPTS_FOLDER=rsg-condo/payment-receipts
